; FTMO ProTrader EA v5.00 — GENETIC OPTIMIZATION preset
; MT5 Strategy Tester → Settings tab → Optimization = "Fast genetic based algorithm"
;   → Inputs tab → Load → this file → Start
;
; Format per line:  Name=value||start||step||stop||Y(optimize)/N(fixed)
;
; FTMO HARD-SAFETY inputs are LOCKED (N) so the optimizer can never search
; into a rule-violating region. Only strategy geometry and PID gains are swept.
; Recommendation: optimize on 2023.01.01–2024.06.30 (in-sample), then forward-
; test the single best pass on 2024.07.01–2024.12.31 (out-of-sample) untouched.

Expert=FTMO_ProTrader_EA
Symbol=EURUSD
Period=H1
Deposit=100000
Currency=USD
Leverage=1:100
Model=1
FromDate=2023.01.01
ToDate=2024.06.30
Optimization=2
OptimizationCriterion=6

[Inputs]
; ---- MODE & FTMO SAFETY — all LOCKED ----
InpFTMOMode=true||false||0||true||N
InpEnforceDailyLimit=true||false||0||true||N
InpEnforceTotalLimit=true||false||0||true||N
InpEnforceProfitStop=true||false||0||true||N
InpMaxDailyLoss=4.5||4.5||0.5||4.5||N
InpMaxTotalLoss=9.0||9.0||0.5||9.0||N
InpProfitTarget=10.0||10.0||1.0||10.0||N
InpMinTradingDays=4||4||1||4||N

; ---- BASE RISK — sweep conservatively ----
InpRiskPerTrade=1.0||0.5||0.25||1.5||Y

; ---- STRATEGY GEOMETRY — primary search space ----
InpFastEMA=20||10||5||30||Y
InpSlowEMA=50||40||10||80||Y
InpTrendEMA=200||150||25||250||Y
InpRSIPeriod=14||14||2||14||N
InpRSIOverbought=65.0||60.0||5.0||75.0||Y
InpRSIOversold=35.0||25.0||5.0||40.0||Y
InpMACDFast=12||12||1||12||N
InpMACDSlow=26||26||1||26||N
InpMACDSignal=9||9||1||9||N
InpATRPeriod=14||14||1||14||N
InpATRSLMulti=1.5||1.0||0.25||2.5||Y
InpATRTPMulti=2.5||1.5||0.25||3.5||Y
InpEntryMode=0||0||0||0||N
InpMinSignals=4||3||1||5||Y
InpBreakoutLookback=20||10||5||30||N
InpADXPeriod=14||10||2||20||Y
InpADXMin=20.0||15.0||2.5||30.0||Y
InpPullbackRSI=50.0||40.0||5.0||60.0||Y

; ---- TRADE MANAGEMENT ----
InpMaxTrades=1||1||1||1||N
InpUseBreakeven=true||false||0||true||N
InpBEAtRR=1.0||0.5||0.5||2.0||Y
InpUseTrailing=true||false||0||true||N
InpTrailATRMulti=1.0||0.5||0.5||2.0||Y
InpMaxSpreadPoints=30||30||5||30||N
InpMagicNumber=202401||202401||1||202401||N

; ---- SESSION / NEWS ----
InpUseLondon=true||false||0||true||N
InpUseNewYork=true||false||0||true||N
InpGMTOffset=0||0||1||0||N
InpUseNewsFilter=true||false||0||true||N
InpNewsMinBefore=30||30||5||30||N
InpNewsMinAfter=30||30||5||30||N
InpFilterHighImpact=true||false||0||true||N
InpFilterMedImpact=false||false||0||true||N

; ---- PID MASTER (bounds locked for FTMO; gains swept) ----
InpPIDEnabled=true||false||0||true||N
InpPIDMinRisk=0.10||0.10||0.05||0.10||N
InpPIDMaxRisk=2.00||2.00||0.25||2.00||N
InpPIDDeadband=0.05||0.02||0.01||0.08||Y
InpPIDDerivFilter=0.50||0.30||0.10||0.70||Y
InpPIDMaxStep=0.25||0.10||0.05||0.40||Y

; ---- EPID (equity velocity) ----
InpEPIDKp=2.0||1.0||0.5||4.0||Y
InpEPIDKi=0.1||0.0||0.05||0.3||Y
InpEPIDKd=0.5||0.0||0.25||1.0||Y
InpEPIDTarget=0.50||0.30||0.10||0.80||Y

; ---- VPID (volatility regime) ----
InpVPIDEnabled=true||false||0||true||N
InpVPIDKp=1.5||0.5||0.5||2.5||Y
InpVPIDKi=0.05||0.0||0.05||0.15||Y
InpVPIDATRMA=20||10||5||30||Y

; ---- WRPID (win-rate) ----
InpWRPIDEnabled=true||false||0||true||N
InpWRPIDKp=1.0||0.5||0.5||2.0||Y
InpWRPIDKi=0.2||0.0||0.1||0.4||Y
InpWRPIDWindow=20||10||5||40||Y
InpWRPIDTarget=0.50||0.40||0.05||0.60||Y

; ---- DVPID (drawdown velocity) ----
InpDVPIDEnabled=true||false||0||true||N
