; FTMO ProTrader EA v5.00 — XAUUSD (GOLD) Backtest Settings
; Momentum-breakout entry mode tuned for gold's session-open bursts.
; Load in MT5 Strategy Tester → Inputs tab → Load.
;
; Attach the EA to an XAUUSD M15 chart. Set Strategy Tester:
;   Symbol=XAUUSD  Period=M15  Leverage=1:100  Model=Every tick (real ticks)

[Tester]
Expert=FTMO_ProTrader_EA
Symbol=XAUUSD
Period=M15
Deposit=100000
Currency=USD
Leverage=1:100
Model=1                  ; Every tick based on real ticks
FromDate=2023.01.01
ToDate=2024.12.31
Optimization=0

[EA]
InpFTMOMode=1
InpEnforceDailyLimit=1
InpEnforceTotalLimit=1
InpEnforceProfitStop=1
InpRiskPerTrade=0.5
InpMaxDailyLoss=4.5
InpMaxTotalLoss=9.0
InpProfitTarget=10.0
InpMinTradingDays=4
InpMainTF=15             ; PERIOD_M15
InpTrendTF=16385         ; PERIOD_H1
InpFastEMA=20
InpSlowEMA=50
InpTrendEMA=200
InpRSIPeriod=14
InpRSIOverbought=70.0
InpRSIOversold=30.0
InpMACDFast=12
InpMACDSlow=26
InpMACDSignal=9
InpATRPeriod=14
InpATRSLMulti=2.0
InpATRTPMulti=3.0
InpEntryMode=1           ; 1 = momentum breakout (gold)
InpMinSignals=4
InpBreakoutLookback=20
InpADXPeriod=14
InpADXMin=20.0
InpPullbackRSI=50.0
InpMaxTrades=1
InpUseBreakeven=1
InpBEAtRR=1.0
InpUseTrailing=1
InpTrailATRMulti=1.5
InpMaxSpreadPoints=50    ; gold spread runs wider than FX
InpMagicNumber=202401
InpUseLondon=1
InpUseNewYork=1
InpGMTOffset=0
InpUseNewsFilter=1
InpNewsMinBefore=30
InpNewsMinAfter=30
InpFilterHighImpact=1
InpFilterMedImpact=0
InpPIDEnabled=1
InpPIDMinRisk=0.10
InpPIDMaxRisk=1.50
InpPIDDeadband=0.05
InpPIDDerivFilter=0.50
InpPIDMaxStep=0.25
InpEPIDKp=2.0
InpEPIDKi=0.1
InpEPIDKd=0.5
InpEPIDTarget=0.50
InpVPIDEnabled=1
InpVPIDKp=1.5
InpVPIDKi=0.05
InpVPIDATRMA=20
InpWRPIDEnabled=1
InpWRPIDKp=1.0
InpWRPIDKi=0.2
InpWRPIDWindow=20
InpWRPIDTarget=0.50
InpDVPIDEnabled=1
InpDVPIDKp=3.0
InpDVPIDKd=1.0
InpDVPIDWindow=5
InpSPIDEnabled=1
InpSPIDKp=2.0
InpSPIDWindow=50
InpShowDashboard=1
InpDashIntervalMs=250
