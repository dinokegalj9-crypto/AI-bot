; MAX ProTrader EA v5.00 — GENETIC OPTIMIZATION preset
; MT5 Strategy Tester → Settings → Optimization = "Fast genetic based algorithm"
;   → Inputs tab → Load → this file → Start
;
; Format per line:  Name=value||start||step||stop||Y(optimize)/N(fixed)
;
; NOT FTMO-compliant — personal/demo capital only. The 50% total-DD kill-switch
; (InpEnforceTotalLimit) stays LOCKED ON so a bad streak can't wipe the account.
; Wider PID ceilings and risk are searched here than in the FTMO preset.
; Optimize in-sample, then forward-test the best pass on untouched data.

Expert=MAX_ProTrader_EA
Symbol=EURUSD
Period=H1
Deposit=100000
Currency=USD
Leverage=1:100
Model=1
FromDate=2023.01.01
ToDate=2024.06.30
Optimization=2
OptimizationCriterion=6

[Inputs]
; ---- MODE — uncapped, kill-switch LOCKED ON ----
InpFTMOMode=false||false||0||true||N
InpEnforceDailyLimit=false||false||0||true||N
InpEnforceTotalLimit=true||false||0||true||N
InpEnforceProfitStop=false||false||0||true||N
InpMaxDailyLoss=8.0||8.0||1.0||8.0||N
InpMaxTotalLoss=45.0||30.0||5.0||45.0||Y
InpProfitTarget=50.0||50.0||5.0||50.0||N
InpMinTradingDays=4||4||1||4||N

; ---- BASE RISK — aggressive sweep ----
InpRiskPerTrade=2.0||1.0||0.5||3.0||Y

; ---- STRATEGY GEOMETRY ----
InpFastEMA=20||10||5||30||Y
InpSlowEMA=50||40||10||80||Y
InpTrendEMA=200||150||25||250||Y
InpRSIPeriod=14||14||2||14||N
InpRSIOverbought=65.0||60.0||5.0||75.0||Y
InpRSIOversold=35.0||25.0||5.0||40.0||Y
InpMACDFast=12||12||1||12||N
InpMACDSlow=26||26||1||26||N
InpMACDSignal=9||9||1||9||N
InpATRPeriod=14||14||1||14||N
InpATRSLMulti=1.5||1.0||0.25||2.5||Y
InpATRTPMulti=2.5||1.5||0.25||4.0||Y
InpMinSignals=4||3||1||5||Y
InpADXPeriod=14||10||2||20||Y
InpADXMin=20.0||15.0||2.5||30.0||Y
InpPullbackRSI=50.0||40.0||5.0||60.0||Y

; ---- TRADE MANAGEMENT — more concurrent trades allowed ----
InpMaxTrades=5||1||1||8||Y
InpUseBreakeven=true||false||0||true||N
InpBEAtRR=1.0||0.5||0.5||2.0||Y
InpUseTrailing=true||false||0||true||N
InpTrailATRMulti=1.0||0.5||0.5||2.0||Y
InpMaxSpreadPoints=30||30||5||50||Y
InpMagicNumber=202402||202402||1||202402||N

; ---- SESSION / NEWS ----
InpUseLondon=true||false||0||true||N
InpUseNewYork=true||false||0||true||N
InpGMTOffset=0||0||1||0||N
InpUseNewsFilter=false||false||0||true||N
InpNewsMinBefore=30||30||5||30||N
InpNewsMinAfter=30||30||5||30||N
InpFilterHighImpact=true||false||0||true||N
InpFilterMedImpact=false||false||0||true||N

; ---- PID MASTER — wider ceilings ----
InpPIDEnabled=true||false||0||true||N
InpPIDMinRisk=0.10||0.10||0.05||0.10||N
InpPIDMaxRisk=5.00||3.00||0.50||6.00||Y
InpPIDDeadband=0.05||0.02||0.01||0.08||Y
InpPIDDerivFilter=0.50||0.30||0.10||0.70||Y
InpPIDMaxStep=0.50||0.25||0.05||0.75||Y

; ---- EPID ----
InpEPIDKp=2.0||1.0||0.5||4.0||Y
InpEPIDKi=0.1||0.0||0.05||0.3||Y
InpEPIDKd=0.5||0.0||0.25||1.0||Y
InpEPIDTarget=0.60||0.40||0.10||1.00||Y

; ---- VPID ----
InpVPIDEnabled=true||false||0||true||N
InpVPIDKp=1.5||0.5||0.5||2.5||Y
InpVPIDKi=0.05||0.0||0.05||0.15||Y
InpVPIDATRMA=20||10||5||30||Y

; ---- WRPID ----
InpWRPIDEnabled=true||false||0||true||N
InpWRPIDKp=1.0||0.5||0.5||2.0||Y
InpWRPIDKi=0.2||0.0||0.1||0.4||Y
InpWRPIDWindow=20||10||5||40||Y
InpWRPIDTarget=0.50||0.40||0.05||0.60||Y

; ---- DVPID ----
InpDVPIDEnabled=true||false||0||true||N
InpDVPIDKp=3.0||2.0||0.5||5.0||Y
InpDVPIDKd=1.0||0.0||0.5||2.0||Y
InpDVPIDWindow=5||3||1||10||Y

; ---- SPID ----
InpSPIDEnabled=true||false||0||true||N
InpSPIDKp=2.0||1.0||0.5||3.0||Y
InpSPIDWindow=50||30||10||100||Y

; ---- DISPLAY ----
InpShowDashboard=false||false||0||true||N
InpDashIntervalMs=250||250||50||250||N
InpLogTrades=true||false||0||true||N
